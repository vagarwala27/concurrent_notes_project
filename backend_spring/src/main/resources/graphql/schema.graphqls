type Query {
  notes: [Note!]!
  note(noteId: ID!): Note
}

type Mutation {
  createNote(input: NoteInput!): Note!
  updateNote(noteId: ID!, input: NoteInput!): Note
  deleteNote(noteId: ID!): Boolean!
}

input NoteInput {
  content: String!
  color: String
}

type Note {
  id: ID!
  content: String!
  color: String!
  summary: String
  updatedAt: String!
}
